{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module":           "esnext",
    "moduleResolution": "bundler",
    "noEmit":           true,
    "target":           "es2022",
    "allowImportingTsExtensions": true,
    "types":            ["vite/client", "node"],
    "lib":              ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": [
    "vue-shims.d.ts",
    "main.ts",
    "vite.config.ts",
    "CartographerState.ts",
    "CartographerServices.ts",
    "dag.ts",
    "dag-validate.ts",
    "record-geo-fixtures.ts",
    "runCartographer.ts",
    "services.ts",
    "tz-lookup.d.ts",
    "app/**/*.ts",
    "contracts/**/*.ts",
    "embedded-dags/**/*.ts",
    "entities/**/*.ts",
    "errors/**/*.ts",
    "nodes/**/*.ts",
    "services/**/*.ts",
    "data/**/*.ts",
    "__smoke__/**/*.ts",
    "geo/**/*.ts",
    "tests/**/*.ts"
  ]
}
