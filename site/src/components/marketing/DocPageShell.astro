---
import DocsArticleShell from '@/components/marketing/DocsArticleShell.astro';
import UiActionLink from '@/components/marketing/UiActionLink.astro';
import UiAsideCard from '@/components/marketing/UiAsideCard.astro';
import UiLinkList from '@/components/marketing/UiLinkList.astro';
import UiPageHeader from '@/components/marketing/UiPageHeader.astro';
import DocSections from '@/components/marketing/DocSections.astro';

interface Crumb {
  readonly href: string;
  readonly label: string;
}

interface HeadingItem {
  readonly depth: number;
  readonly slug: string;
  readonly text: string;
}

interface Props {
  title: string;
  description: string;
  headings: readonly HeadingItem[];
  sections: readonly unknown[];
  sourceLabel?: string;
  sourceHref?: string;
  crumbs: readonly Crumb[];
  readingMode?: string;
}

const {
  title,
  description,
  headings,
  sections,
  sourceLabel,
  sourceHref,
  crumbs,
  readingMode = 'This page focuses on the core model, contracts, and operating semantics so the content stays readable, indexable, and easy to reference.'
} = Astro.props;

const hasDefaultSlot = Astro.slots.has('default');
const headingLinks = headings.map((heading) => ({
  href: `#${heading.slug}`,
  label: `${heading.depth > 2 ? '↳ ' : heading.depth > 1 ? '– ' : ''}${heading.text}`
}));
---

<DocsArticleShell title={title} description={description}>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <article class="space-y-8">
      <UiPageHeader title={title} description={description} crumbs={crumbs} />
      {
        hasDefaultSlot ? (
          <div class="docs-content">
            <slot />
          </div>
        ) : (
          <DocSections sections={sections} />
        )
      }
    </article>

    <aside class="space-y-5">
      {
        (sourceLabel || sourceHref) && (
          <UiAsideCard title="Source file">
            {sourceLabel && <p class="mt-3 break-all text-sm text-slate-300">{sourceLabel}</p>}
            {sourceHref && (
              <UiActionLink href={sourceHref} target="_blank" rel="noreferrer" variant="text" class="mt-4 justify-start px-0">
                View source on GitHub
              </UiActionLink>
            )}
          </UiAsideCard>
        )
      }

      {
        headings.length > 0 && (
          <UiAsideCard title="Headings">
            <UiLinkList links={headingLinks} />
          </UiAsideCard>
        )
      }

      <UiAsideCard title="Reading mode">
        <p class="mt-3 text-sm leading-6 text-slate-300">{readingMode}</p>
      </UiAsideCard>
    </aside>
  </div>
</DocsArticleShell>

<script>
  import '@/lib/doc-diagram-embed-client';
</script>
