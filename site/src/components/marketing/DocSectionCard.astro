---
import { SiteDocs } from '@/lib/docs';
import { SiteLinks } from '@/lib/links';
import UiLinkCard from '@/components/islands/UiLinkCard.vue';

interface Props {
  entry: Awaited<ReturnType<typeof SiteDocs.catalog>>[number];
}

const { entry } = Astro.props;
---

<UiLinkCard
  href={SiteLinks.site(entry.url)}
  eyebrow={entry.section}
  meta={entry.slug}
  title={entry.title}
  body={entry.description || entry.excerpt}
/>
