---
import UiActionLink from '@/components/islands/UiActionLink.vue';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  block?: boolean;
  target?: string;
  rel?: string;
  class?: string;
}

const { href, variant = 'secondary', block = false, target, rel, class: className = '' } = Astro.props;
---

<UiActionLink href={href} variant={variant} block={block} target={target} rel={rel} className={className}>
  <slot />
</UiActionLink>
