---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNav from '@/components/marketing/TopNav.astro';
import MarketingFooter from '@/components/marketing/MarketingFooter.astro';

interface Props {
  title: string;
  description: string;
  contentMaxWidth?: string;
}

const {
  title,
  description,
  contentMaxWidth = 'max-w-6xl'
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class:list={['mx-auto flex min-h-screen flex-col gap-8 px-4 py-4 md:px-6 md:py-6', contentMaxWidth]}>
    <TopNav />

    <section class="hex-shell bg-slate-950/72 px-8 py-10 shadow-[0_30px_120px_-48px_rgba(15,23,42,1)] backdrop-blur md:px-10 md:py-12">
      <slot />
    </section>
  </main>

  <MarketingFooter />
</BaseLayout>
