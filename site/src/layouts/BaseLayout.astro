---
import '@/styles/global.css';
import { siteConfig } from '@/config/site';
import { SiteLinks } from '@/lib/links';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteConfig.title, description = siteConfig.description } = Astro.props;
const fullTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const pathname = Astro.url.pathname;
const canonicalUrl = new URL(pathname, siteConfig.siteUrl).toString();
const ogImageUrl = new URL(SiteLinks.site(siteConfig.ogImage), siteConfig.siteUrl).toString();
const displayTitle = fullTitle;
const isDocsExamplePage = pathname.startsWith(`${siteConfig.basePath}/docs/examples/`);
const pathWithoutBase = pathname.startsWith(siteConfig.basePath)
  ? pathname.slice(siteConfig.basePath.length).replace(/^\/+/, '')
  : pathname.replace(/^\/+/, '');
const routeSegments = pathWithoutBase.length === 0 ? [] : pathWithoutBase.replace(/\/$/, '').split('/');
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: siteConfig.title,
    item: new URL(SiteLinks.site('/'), siteConfig.siteUrl).toString()
  },
  ...routeSegments.map((segment, index) => {
    const accumulated = routeSegments.slice(0, index + 1).join('/');
    const isLast = index === routeSegments.length - 1;
    return {
      '@type': 'ListItem',
      position: index + 2,
      name: isLast ? title : segment.replace(/-/g, ' ').replace(/\b\w/g, (char) => char.toUpperCase()),
      item: new URL(SiteLinks.site(`/${accumulated}`), siteConfig.siteUrl).toString()
    };
  })
];
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.title,
  url: new URL(SiteLinks.site('/'), siteConfig.siteUrl).toString(),
  description: siteConfig.description,
  inLanguage: 'en-US'
};
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: siteConfig.title,
  description: siteConfig.description,
  url: new URL(SiteLinks.site('/'), siteConfig.siteUrl).toString(),
  codeRepository: siteConfig.repoUrl,
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'Node.js >=24',
  license: 'https://opensource.org/licenses/MIT',
  image: ogImageUrl,
  author: {
    '@type': 'Person',
    name: siteConfig.authorName,
    url: siteConfig.authorUrl
  }
};
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.title,
  url: new URL(SiteLinks.site('/'), siteConfig.siteUrl).toString(),
  logo: new URL(SiteLinks.site('/dagonizer-icon.svg'), siteConfig.siteUrl).toString(),
  sameAs: [siteConfig.repoUrl, siteConfig.npmUrl, siteConfig.authorUrl],
  founder: {
    '@type': 'Person',
    name: siteConfig.authorName,
    url: siteConfig.authorUrl
  }
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems
};
const howToSchema = isDocsExamplePage
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: displayTitle,
      description,
      url: canonicalUrl,
      image: ogImageUrl
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={siteConfig.primaryColor} />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="bingbot" content="index, follow" />
    <meta name="author" content={siteConfig.authorName} />
    <meta name="application-name" content={siteConfig.title} />
    <meta name="generator" content="Astro" />
    <meta name="referrer" content="origin-when-cross-origin" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={SiteLinks.site('/dagonizer-icon.svg')} />
    <link rel="icon" type="image/x-icon" href={SiteLinks.site('/favicon.ico')} />
    <link rel="icon" type="image/png" sizes="32x32" href={SiteLinks.site('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="192x192" href={SiteLinks.site('/favicon-192.png')} />
    <link rel="shortcut icon" href={SiteLinks.site('/favicon.ico')} />
    <link rel="apple-touch-icon" sizes="180x180" href={SiteLinks.site('/apple-touch-icon.png')} />
    <link rel="manifest" href={SiteLinks.site('/manifest.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={SiteLinks.site('/sitemap-index.xml')} />
    <link rel="alternate" hreflang="en-US" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL(SiteLinks.site('/'), siteConfig.siteUrl).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={displayTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={displayTitle} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
  </head>
  <body class="antialiased">
    <div class="grid-noise pointer-events-none fixed inset-0 opacity-25"></div>
    <slot />
  </body>
</html>
