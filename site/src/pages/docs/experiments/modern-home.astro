---
import { getEntry } from 'astro:content';
import DocsArticleShell from '@/components/marketing/DocsArticleShell.astro';
import UiActionLink from '@/components/marketing/UiActionLink.astro';
import UiAsideCard from '@/components/marketing/UiAsideCard.astro';
import UiLinkList from '@/components/marketing/UiLinkList.astro';
import UiPageHeader from '@/components/marketing/UiPageHeader.astro';
import HomeHeroSection from '@/components/islands/HomeHeroSection.vue';
import UiMarketingCardGrid from '@/components/islands/UiMarketingCardGrid.vue';
import UiSectionIntro from '@/components/islands/UiSectionIntro.vue';
import { siteHref } from '@/lib/links';
import { toEditUrl } from '@/lib/docs';

const doc = await getEntry('docs', 'experiments/modern-home');

if (doc === undefined) {
  throw new Error('Missing docs/experiments/modern-home.md content for Astro site.');
}

const pageTitle = doc.data.title ?? 'Modern home concept';
const pageDescription =
  doc.data.description ??
  'Typed orchestration for agent workflows, resumable pipelines, and inspectable DAG execution.';

const crumbs = [
  { href: siteHref('/docs'), label: 'Docs' },
  { href: siteHref('/docs/experiments'), label: 'Experiments' },
  { href: siteHref('/docs/experiments/modern-home'), label: pageTitle }
] as const;

const featureCards = [
  {
    badge: 'λ',
    title: 'Typed graph contracts',
    body: 'Route work through explicit ports, declared terminals, and runtime documents that stay legible under change.'
  },
  {
    badge: '↻',
    title: 'Durable resume',
    body: 'Capture execution state, persist it outside process memory, and continue from the recorded cursor.'
  },
  {
    badge: '⬡',
    title: 'First-class graph behavior',
    body: 'Compose scatter, gather, embedded DAGs, streaming producers, and hand-offs without hiding control flow.'
  }
] as const;

const relatedLinks = [
  { href: siteHref('/'), label: 'Current Astro home' },
  { href: siteHref('/docs/architecture'), label: 'Architecture' },
  { href: siteHref('/docs/guide/visualization'), label: 'Visualization guide' }
] as const;
---

<DocsArticleShell title={pageTitle} description={pageDescription}>
  <div class="grid gap-8 xl:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
    <article class="space-y-8">
      <UiPageHeader title={pageTitle} description={pageDescription} crumbs={crumbs} />

      <div class="overflow-hidden rounded-[1.75rem] border border-white/10 bg-slate-950/50">
        <HomeHeroSection
          client:visible
          gettingStartedHref={siteHref('/getting-started')}
          visualizeHref={siteHref('/#visualize')}
        />
      </div>

      <section class="space-y-5">
        <UiSectionIntro
          eyebrow="Concept direction"
          title="A cleaner marketing shell for the Astro cut-over"
          description="This experiment carries the current home-page direction into the docs surface so the same branded hero, CTA treatment, and runtime framing can be reviewed in the Astro marketing shell with the same runtime story."
        />
        <UiMarketingCardGrid client:visible items={featureCards} />
      </section>
    </article>

    <aside class="space-y-5">
      <UiAsideCard title="Why this page exists">
        <div class="space-y-3 text-sm leading-6 text-slate-300">
          <p>This route keeps the concept reviewable as a first-class Astro page instead of an embedded one-off.</p>
          <p>It is the current experimental surface for branding direction, hero framing, and top-level CTA treatment.</p>
        </div>
      </UiAsideCard>

      <UiAsideCard title="Source file">
        <p class="mt-3 break-all text-sm text-slate-300">experiments/modern-home.md</p>
        <UiActionLink
          href={toEditUrl('experiments/modern-home')}
          target="_blank"
          rel="noreferrer"
          variant="text"
          class="mt-4 justify-start px-0"
        >
          View source on GitHub
        </UiActionLink>
      </UiAsideCard>

      <UiAsideCard title="Related">
        <UiLinkList links={relatedLinks} />
      </UiAsideCard>
    </aside>
  </div>
</DocsArticleShell>
