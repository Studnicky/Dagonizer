---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNav from '@/components/marketing/TopNav.astro';
import MarketingFooter from '@/components/marketing/MarketingFooter.astro';
import UiAsideCard from '@/components/marketing/UiAsideCard.astro';
import UiLinkList from '@/components/marketing/UiLinkList.astro';
import UiPageHeader from '@/components/marketing/UiPageHeader.astro';
import LazyDispatcherRunner from '@/components/islands/LazyDispatcherRunner.vue';
import { siteHref } from '@/lib/links';

const relatedLinks = [
  { href: siteHref('/docs/examples/the-archivist'), label: 'The Archivist' },
  { href: siteHref('/docs/examples/the-cartographer'), label: 'The Cartographer' },
  { href: siteHref('/docs/guide/visualization'), label: 'Visualization guide' }
] as const;

const crumbs = [
  { href: siteHref('/docs'), label: 'Docs' },
  { href: siteHref('/docs/examples/the-dispatcher'), label: 'Examples' }
] as const;
---

<BaseLayout
  title="The Dispatcher"
  description="Runnable Dagonizer example for routing, pause-and-resume, and human-in-the-loop orchestration with checkpoint continuity."
>
  <main class="mx-auto flex min-h-screen max-w-7xl flex-col gap-8 px-4 py-4 md:px-6 md:py-6">
    <TopNav />

    <section class="rounded-[2rem] border border-white/10 bg-slate-950/72 px-6 py-8 shadow-[0_30px_120px_-48px_rgba(15,23,42,1)] backdrop-blur md:px-8 md:py-10">
      <UiPageHeader
        title="The Dispatcher"
        description="A routing workflow that shows how Dagonizer handles pause points, operator handoff, and checkpoint-based resume without losing execution context."
        crumbs={crumbs}
      />

      <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
        <div class="space-y-8">
          <LazyDispatcherRunner client:visible />
        </div>

        <aside class="space-y-5">
          <UiAsideCard title="What this proves">
            <div class="space-y-3 text-sm leading-6 text-slate-300">
              <p>Human-in-the-loop orchestration can remain deterministic even when a workflow must stop and wait for operator input.</p>
              <p>Checkpoint continuity lets teams resume from the exact control boundary instead of rebuilding state by hand.</p>
              <p>Dagonizer supports routing logic that spans automated classification and explicit human takeover.</p>
            </div>
          </UiAsideCard>

          <UiAsideCard title="Related">
            <UiLinkList links={relatedLinks} />
          </UiAsideCard>
        </aside>
      </div>
    </section>
  </main>
  <MarketingFooter />
</BaseLayout>
