---
import DocsArticleShell from '@/components/marketing/DocsArticleShell.astro';
import UiPageHeader from '@/components/marketing/UiPageHeader.astro';
import UiAsideCard from '@/components/marketing/UiAsideCard.astro';
import UiLinkList from '@/components/marketing/UiLinkList.astro';
import UiMarketingCardGrid from '@/components/islands/UiMarketingCardGrid.vue';
import UiSectionIntro from '@/components/islands/UiSectionIntro.vue';
import { siteHref } from '@/lib/links';

const crumbs = [
  { href: siteHref('/docs'), label: 'Docs' },
  { href: siteHref('/docs/examples'), label: 'Examples' }
] as const;

const runnableExamples = [
  {
    eyebrow: 'Runnable',
    title: 'The Archivist',
    body: 'Tool-assisted bibliographic research, retries, memory, and response composition in one observable DAG.',
    href: siteHref('/docs/examples/the-archivist')
  },
  {
    eyebrow: 'Runnable',
    title: 'The Dispatcher',
    body: 'Routing, pause-and-resume, and human-in-the-loop checkpoint continuity across a support workflow.',
    href: siteHref('/docs/examples/the-dispatcher')
  },
  {
    eyebrow: 'Runnable',
    title: 'The Cartographer',
    body: 'Deterministic intake, enrichment, geo-resolution, and insight fan-in across a data pipeline.',
    href: siteHref('/docs/examples/the-cartographer')
  }
] as const;

const docExampleLinks = [
  { href: siteHref('/docs/examples/01-linear'), label: 'Example 01: Linear DAG' },
  { href: siteHref('/docs/examples/02-builder'), label: 'Example 02: DAGBuilder' },
  { href: siteHref('/docs/examples/04-scatter'), label: 'Example 04: Scatter Scout' },
  { href: siteHref('/docs/examples/08-checkpoint'), label: 'Example 08: Checkpoint and Resume' },
  { href: siteHref('/docs/examples/18-observability'), label: 'Example 18: Observability' },
  { href: siteHref('/docs/examples/35-stream-fanin-resume'), label: 'Example 35: Stream fan-in resume' }
] as const;
---

<DocsArticleShell title="Examples" description="Runnable Dagonizer demos plus focused example docs for graph authoring, execution behavior, and runtime inspection.">
  <div class="grid gap-8 xl:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
    <article class="space-y-8">
      <UiPageHeader
        title="Examples"
        description="Use the runnable demos for end-to-end workflows, then move into the focused example pages when you want one runtime behavior or graph pattern in isolation."
        crumbs={crumbs}
      />

      <section class="space-y-5">
        <UiSectionIntro
          eyebrow="Runnable surfaces"
          title="Live DAGs for the main workflow families"
          description="These are the highest-value entry points for evaluating the framework: they show the visualization, controls, runtime state, and execution semantics together instead of splitting them across separate pages."
        />
        <UiMarketingCardGrid client:visible items={runnableExamples} linkCards />
      </section>
    </article>

    <aside class="space-y-5">
      <UiAsideCard title="Focused docs examples">
        <UiLinkList links={docExampleLinks} />
      </UiAsideCard>

      <UiAsideCard title="Next">
        <div class="space-y-3 text-sm leading-6 text-slate-300">
          <p>Start with the runnable surfaces when you want to see end-to-end behavior.</p>
          <p>Use the focused docs examples when you need a single concept like scatter, gather, checkpoints, observability, or streaming in isolation.</p>
        </div>
      </UiAsideCard>
    </aside>
  </div>
</DocsArticleShell>
