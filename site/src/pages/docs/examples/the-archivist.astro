---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNav from '@/components/marketing/TopNav.astro';
import MarketingFooter from '@/components/marketing/MarketingFooter.astro';
import UiAsideCard from '@/components/marketing/UiAsideCard.astro';
import UiLinkList from '@/components/marketing/UiLinkList.astro';
import UiPageHeader from '@/components/marketing/UiPageHeader.astro';
import LazyArchivistRunner from '@/components/islands/LazyArchivistRunner.vue';
import { siteHref } from '@/lib/links';

const relatedLinks = [
  { href: siteHref('/docs/guide/visualization'), label: 'Visualization guide' },
  { href: siteHref('/docs/architecture'), label: 'Architecture' },
  { href: siteHref('/docs/concepts'), label: 'Concepts' }
] as const;

const crumbs = [
  { href: siteHref('/docs'), label: 'Docs' },
  { href: siteHref('/docs/examples/the-archivist'), label: 'Examples' }
] as const;
---

<BaseLayout
  title="The Archivist"
  description="Runnable Dagonizer example for research and synthesis workflows with observable execution, tool use, and bounded retries."
>
  <main class="mx-auto flex min-h-screen max-w-7xl flex-col gap-8 px-4 py-4 md:px-6 md:py-6">
    <TopNav />

    <section class="rounded-[2rem] border border-white/10 bg-slate-950/72 px-6 py-8 shadow-[0_30px_120px_-48px_rgba(15,23,42,1)] backdrop-blur md:px-8 md:py-10">
      <UiPageHeader
        title="The Archivist"
        description="A research and synthesis workflow that shows how Dagonizer handles tool-driven retrieval, validation, and controlled retry inside one observable DAG."
        crumbs={crumbs}
      />

      <div class="mt-8 grid gap-8 xl:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
        <div class="space-y-8">
          <LazyArchivistRunner client:visible />
        </div>

        <aside class="space-y-5">
          <UiAsideCard title="What this proves">
            <div class="space-y-3 text-sm leading-6 text-slate-300">
              <p>The demo page can move to Astro without waiting for a full runner rewrite.</p>
              <p>Research-oriented DAGs can expose every decision point, tool call, and retry boundary without hiding runtime behavior.</p>
              <p>Teams evaluating Dagonizer can inspect a realistic orchestration flow instead of reading a static diagram alone.</p>
            </div>
          </UiAsideCard>

          <UiAsideCard title="Related">
            <UiLinkList links={relatedLinks} />
          </UiAsideCard>
        </aside>
      </div>
    </section>
  </main>
  <MarketingFooter />
</BaseLayout>
