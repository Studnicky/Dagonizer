---
import DocsArticleShell from '@/components/marketing/DocsArticleShell.astro';
import UiPageHeader from '@/components/marketing/UiPageHeader.astro';
import UiAsideCard from '@/components/marketing/UiAsideCard.astro';
import UiLinkList from '@/components/marketing/UiLinkList.astro';
import UiSectionIntro from '@/components/islands/UiSectionIntro.vue';
import { SiteLinks } from '@/lib/links';

return Astro.redirect(SiteLinks.site(SiteLinks.route('internal')), 301);

const crumbs = [
  { href: SiteLinks.site('/docs'), label: 'Docs' },
  { href: SiteLinks.site('/docs/internal'), label: 'Internal' }
] as const;

const internalLinks = [
  { href: SiteLinks.site('/docs/internal/graph-state-transfer'), label: 'Graph state transfer' },
  { href: SiteLinks.site('/docs/reference/runtime'), label: 'Runtime reference' },
  { href: SiteLinks.site('/docs/guide/checkpoint'), label: 'Checkpoint guide' }
] as const;
---

<DocsArticleShell title="Internal" description="Implementation notes for internal runtime mechanics that support checkpointing, state transfer, and related lower-level runtime behavior.">
  <div class="grid gap-8 xl:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)]">
    <article class="space-y-8">
      <UiPageHeader
        title="Internal"
        description="Use the internal section for lower-level runtime mechanics such as state transfer, checkpoint internals, and runtime implementation details."
        crumbs={crumbs}
      />

      <UiSectionIntro
        eyebrow="Internal entry points"
        title="Lower-level runtime mechanics"
        description="Start with graph-state transfer when you need to understand how execution state crosses container or transport boundaries."
      />
    </article>

    <aside class="space-y-5">
      <UiAsideCard title="Internal links">
        <UiLinkList links={internalLinks} />
      </UiAsideCard>
    </aside>
  </div>
</DocsArticleShell>
